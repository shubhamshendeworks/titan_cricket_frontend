# ─── Cricket Tournament Platform — Frontend Environment Variables ─────────────
#
# SETUP:
#   • Local dev  → copy this file to .env.local and keep the localhost values.
#   • Production → set these as environment variables in Vercel:
#                  Vercel Dashboard → Project → Settings → Environment Variables
#
# IMPORTANT: VITE_* variables are baked into the JS bundle at build time by
# Vite. They are NOT secrets. Do not put API keys or passwords here.
# The app will throw a clear startup error if a required variable is missing.
# ──────────────────────────────────────────────────────────────────────────────

# ─── Backend API URL ──────────────────────────────────────────────────────────
# Local dev:
VITE_API_BASE_URL=http://localhost:8000/api/v1
# Production (set in Vercel, not here):
# VITE_API_BASE_URL=https://titan-cricket-backend.onrender.com/api/v1

# ─── Backend WebSocket URL ────────────────────────────────────────────────────
# Local dev:
VITE_WS_BASE_URL=ws://localhost:8000/api/v1
# Production (set in Vercel, not here):
# VITE_WS_BASE_URL=wss://titan-cricket-backend.onrender.com/api/v1

# ─── App metadata ─────────────────────────────────────────────────────────────
VITE_APP_NAME="Cricket Tournament Platform"
VITE_APP_VERSION=0.1.0
