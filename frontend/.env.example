# ─── Cricket Tournament Platform — Frontend Environment Variables ─────────────
#
# SETUP:
#   • Local dev  → copy this file to .env.local and keep the localhost values.
#   • Production → set these in Vercel Dashboard → Project → Settings →
#                  Environment Variables. Do NOT commit production values.
#
# VITE_* variables are baked into the JS bundle at build time by Vite.
# They are NOT secret. Do not put passwords or API keys here.
#
# IMPORTANT — VITE_API_BASE_URL and VITE_WS_BASE_URL:
#   The code normalises the value automatically, so both forms are accepted:
#     https://titan-cricket-backend.onrender.com          ← host only
#     https://titan-cricket-backend.onrender.com/api/v1  ← host + prefix
#   The /api/v1 prefix is always appended exactly once. Never include a
#   trailing slash.
# ──────────────────────────────────────────────────────────────────────────────

# ─── Backend REST API ─────────────────────────────────────────────────────────
# Local dev:
VITE_API_BASE_URL=http://localhost:8000/api/v1
# Production value to set in Vercel (not here):
# VITE_API_BASE_URL=https://titan-cricket-backend.onrender.com/api/v1

# ─── Backend WebSocket ────────────────────────────────────────────────────────
# Local dev:
VITE_WS_BASE_URL=ws://localhost:8000/api/v1
# Production value to set in Vercel (not here):
# VITE_WS_BASE_URL=wss://titan-cricket-backend.onrender.com/api/v1

# ─── App metadata ─────────────────────────────────────────────────────────────
VITE_APP_NAME="Cricket Tournament Platform"
VITE_APP_VERSION=0.1.0
