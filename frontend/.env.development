# ─── Local development defaults ───────────────────────────────────────────────
# Loaded automatically by Vite when running: npm run dev
# Do NOT commit secrets here. These values point to a local backend.
# Override per-machine with .env.development.local (git-ignored).
# ──────────────────────────────────────────────────────────────────────────────

VITE_API_BASE_URL=http://localhost:8000/api/v1
VITE_WS_BASE_URL=ws://localhost:8000/api/v1
VITE_APP_NAME="Cricket Tournament Platform"
VITE_APP_VERSION=0.1.0
